{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "aquarium-view",
          "type": "stack",
          "active": "tank-view",
          "children": [
            {
              "id": "tank-view",
              "type": "block",
              "background": {
                "image": "mods/aquarium/assets/habitat-full.svg",
                "fit": "cover"
              },
              "content": {
                "mod": "aquarium",
                "props": {
                  "immersive": true
                }
              }
            },
            {
              "id": "terminal-view",
              "type": "column",
              "children": [
                {
                  "id": "terminal-nav",
                  "type": "block",
                  "size": {
                    "px": 42
                  },
                  "window_drag": true,
                  "content": {
                    "mod": "aquarium",
                    "props": {
                      "terminal": true
                    }
                  }
                },
                {
                  "id": "fish-terminal",
                  "type": "block",
                  "content": {
                    "agent": "focused"
                  },
                  "padding": 8
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ],
  "theme": "aquarium",
  "preview": "mods/aquarium/assets/habitat-full.svg",
  "terminal_opacity": 1
}
